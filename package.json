{
  "name": "diosem-work-manager-sales",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sales": "vite --mode sales",
    "dev:tech": "vite --mode tech",
    "build": "npm run build:sales",
    "build:sales": "vite build --mode sales --outDir dist-sales",
    "build:tech": "vite build --mode tech --outDir dist-tech",
    "test": "node --test",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build:sales && gh-pages -d dist-sales"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  }
}
